# Copy on EC2 only:  cp deploy/aws/env.example deploy/aws/production.env
# Edit deploy/aws/production.env (never commit production.env)

# Frontend Docker build (baked into static JS)
VITE_API_URL=https://backend.ktauction.in/api

# Backend
CORS_ORIGINS=https://ktauction.in,https://www.ktauction.in
DB_URL=jdbc:mysql://mysql:3306/cricket_auction?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me
JWT_SECRET=change-me-long-random
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
PUBLIC_BASE_URL=https://backend.ktauction.in
UPLOAD_DIR=/tmp/cricket-auction-uploads
