# Copy this file to .env.local for local development
# On Netlify: set VITE_API_URL in Site Settings → Environment Variables

# Local development
VITE_API_URL=http://localhost:8080/api

# AWS Docker build / production frontend (set in deploy/aws/production.env, not here)
# VITE_API_URL=https://backend.ktauction.in/api

# Render + Netlify backup (set in Netlify dashboard → Environment variables)
# VITE_API_URL=https://cricket-auction-backend.onrender.com/api
